# Copie este arquivo para ".env" e ajuste os valores.

# String de conexão do PostgreSQL.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
# Se estiver usando o docker-compose.yml da raiz do projeto, este valor já
# corresponde ao serviço "db" definido nele.
DATABASE_URL="postgresql://alertacidade:alertacidade@localhost:5432/alertacidade?schema=public"

# Supabase Auth e URLs públicas de arquivos.
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-chave-publica"

# Obrigatória no backend para criar usuários de equipe e redefinir senhas.
# Configure também no ambiente de deploy do backend. Nunca use no frontend.
SUPABASE_SECRET_KEY="sua-chave-secreta"

# Porta em que a API vai escutar.
PORT=3333

# Ambiente de execução: development | production | test
NODE_ENV=development

# Segredo usado para assinar os tokens JWT. Gere um valor forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-valor-por-um-segredo-forte-e-aleatorio"

# Tempo de expiração do token de acesso.
JWT_EXPIRES_IN="7d"

# Origem(ns) permitida(s) para requisições do front-end (CORS).
# Use "*" apenas em desenvolvimento.
CORS_ORIGIN="http://localhost:5500"

# Limites de upload de mídia das denúncias.
MAX_IMAGE_SIZE_MB=8
MAX_VIDEO_SIZE_MB=120
MAX_VIDEO_DURATION_SECONDS=180

# Render: anexe um Persistent Disk em /var/data e configure este diretório.
# Localmente, omita a variável para usar backend/uploads.
# UPLOAD_DIR=/var/data/uploads
